name "d-osm-benchmarks"
description "Reproducible micro- and end-to-end benchmarks for d-osm"
authors "Alexander Bernardi"
copyright "Copyright © 2026 Alexander Bernardi"
license "MIT"

dependency "d-osm" path=".."

configuration "varint" {
    targetType "executable"
    targetName "d-osm-bench-varint"
    targetPath "bin"
    sourcePaths "micro"
    importPaths "micro"
    mainSourceFile "micro/varint.d"
}

configuration "dense-nodes" {
    targetType "executable"
    targetName "d-osm-bench-dense-nodes"
    targetPath "bin"
    sourcePaths "micro"
    importPaths "micro"
    mainSourceFile "micro/dense_nodes.d"
}

configuration "regular-nodes" {
    targetType "executable"
    targetName "d-osm-bench-regular-nodes"
    targetPath "bin"
    sourcePaths "micro"
    importPaths "micro"
    mainSourceFile "micro/regular_nodes.d"
}

configuration "dense-coordinate-stages" {
    targetType "executable"
    targetName "d-osm-bench-dense-coordinate-stages"
    targetPath "bin"
    sourcePaths "micro"
    importPaths "micro"
    mainSourceFile "micro/dense_coordinate_stages.d"
}

configuration "dense-varint-core" {
    targetType "executable"
    targetName "d-osm-bench-dense-varint-core"
    targetPath "bin"
    sourcePaths "micro"
    importPaths "micro"
    mainSourceFile "micro/dense_varint_core.d"
}

configuration "regular-node-stages" {
    targetType "executable"
    targetName "d-osm-bench-regular-node-stages"
    targetPath "bin"
    sourcePaths "micro"
    importPaths "micro"
    mainSourceFile "micro/regular_nodes.d"
    versions "RegularNodeStageBenchmark"
}

configuration "regular-ways" {
    targetType "executable"
    targetName "d-osm-bench-regular-ways"
    targetPath "bin"
    sourcePaths "micro"
    importPaths "micro"
    mainSourceFile "micro/regular_ways.d"
}
