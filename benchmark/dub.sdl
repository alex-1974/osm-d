name "osm-d-benchmarks"
description "Reproducible micro- and end-to-end benchmarks for osm-d"
authors "Alexander Bernardi"
copyright "Copyright © 2026 Alexander Bernardi"
license "MIT"

dependency "osm-d" path=".."

configuration "varint" {
    targetType "executable"
    targetName "osm-d-bench-varint"
    targetPath "bin"
    sourcePaths "micro"
    importPaths "micro"
    mainSourceFile "micro/varint.d"
}

configuration "dense-nodes" {
    targetType "executable"
    targetName "osm-d-bench-dense-nodes"
    targetPath "bin"
    sourcePaths "micro"
    importPaths "micro"
    mainSourceFile "micro/dense_nodes.d"
}

configuration "regular-nodes" {
    targetType "executable"
    targetName "osm-d-bench-regular-nodes"
    targetPath "bin"
    sourcePaths "micro"
    importPaths "micro"
    mainSourceFile "micro/regular_nodes.d"
}

configuration "dense-coordinate-stages" {
    targetType "executable"
    targetName "osm-d-bench-dense-coordinate-stages"
    targetPath "bin"
    sourcePaths "micro"
    importPaths "micro"
    mainSourceFile "micro/dense_coordinate_stages.d"
}

configuration "dense-varint-core" {
    targetType "executable"
    targetName "osm-d-bench-dense-varint-core"
    targetPath "bin"
    sourcePaths "micro"
    importPaths "micro"
    mainSourceFile "micro/dense_varint_core.d"
}

configuration "regular-node-stages" {
    targetType "executable"
    targetName "osm-d-bench-regular-node-stages"
    targetPath "bin"
    sourcePaths "micro"
    importPaths "micro"
    mainSourceFile "micro/regular_nodes.d"
    versions "RegularNodeStageBenchmark"
}

configuration "regular-ways" {
    targetType "executable"
    targetName "osm-d-bench-regular-ways"
    targetPath "bin"
    sourcePaths "micro"
    importPaths "micro"
    mainSourceFile "micro/regular_ways.d"
}

configuration "regular-way-stages" {
    targetType "executable"
    targetName "osm-d-bench-regular-way-stages"
    targetPath "bin"
    sourcePaths "micro"
    importPaths "micro"
    mainSourceFile "micro/regular_ways.d"
    versions "RegularWayStageBenchmark"
}

configuration "parser-decode-count" {
    targetType "executable"
    targetName "osm-d-bench-decode-count"
    targetPath "bin"
    sourcePaths "parser"
    importPaths "parser"
    mainSourceFile "parser/decode_count.d"
}


configuration "parser-push-filter" {
    targetType "executable"
    targetName "osm-d-bench-push-filter"
    targetPath "bin"
    sourcePaths "parser"
    importPaths "parser"
    mainSourceFile "parser/push_filter.d"
}


configuration "parser-source-compare" {
    targetType "executable"
    targetName "osm-d-bench-source-compare"
    targetPath "bin"
    sourcePaths "parser"
    importPaths "parser"
    mainSourceFile "parser/source_compare.d"
}


configuration "parser-memory-baseline" {
    targetType "executable"
    targetName "osm-d-bench-memory-baseline"
    targetPath "bin"
    sourcePaths "parser"
    importPaths "parser"
    mainSourceFile "parser/memory_baseline.d"
}


configuration "parser-parallel-summary" {
    targetType "executable"
    targetName "osm-d-bench-parallel-summary"
    targetPath "bin"
    sourcePaths "parser"
    importPaths "parser"
    mainSourceFile "parser/parallel_summary.d"
}


configuration "store-layout" {
    targetType "executable"
    targetName "osm-d-bench-store-layout"
    targetPath "bin"
    sourcePaths "store"
    importPaths "store"
    mainSourceFile "store/layout_compare.d"
